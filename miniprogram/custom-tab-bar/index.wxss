.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  background: #FFFFFF;
  border-top: 2rpx solid #EFE4D2;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 12rpx;
  color: #8A7F6F;
}

.tab-hover {
  background: #F7F0E4;
}

.tab-active {
  color: #2C5F8A;
}

.tab-icon {
  font-size: 48rpx;
  line-height: 1.25;
}

.tab-text {
  font-size: 34rpx;
  font-weight: bold;
  margin-top: 2rpx;
  line-height: 1.3;
}
