/**
 * app.wxss —— 全局样式
 * 适老化设计：正文字号不低于 36rpx(约18px)，关键数字 44rpx 以上，
 * 可点击区域高度不小于 110rpx，颜色方案为米白底 + 深蓝主色 + 暖橙强调。
 */

page {
  background: #FDF8F0;
  color: #2D2D2D;
  font-size: 40rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

view, text, button, input, textarea, picker, scroll-view, canvas, image {
  box-sizing: border-box;
}

/* 去掉微信 button 默认边框、背景和圆角 */
button {
  margin: 0;
  padding: 0;
  background: none;
  border-radius: 0;
  line-height: 1.5;
  font-size: 40rpx;
  color: #2D2D2D;
  text-align: center;
}

button::after {
  border: none;
}

/* 有底部导航的 tab 页：为底部留出自定义导航高度 + iPhone 安全区 */
.tab-page {
  padding: 24rpx 28rpx calc(220rpx + env(safe-area-inset-bottom));
}

/* 无底部导航的二级页面 */
.sub-page {
  padding: 24rpx 28rpx calc(90rpx + env(safe-area-inset-bottom));
}

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 26rpx;
  padding: 30rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 95, 138, 0.08);
}

.card-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #2C5F8A;
  margin-bottom: 24rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

/* 大按钮：高度不小于 110rpx（约55px+） */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 116rpx;
  padding: 0 44rpx;
  border-radius: 58rpx;
  font-size: 42rpx;
  font-weight: bold;
  line-height: 1.4;
}

.btn-primary {
  background: #2C5F8A;
  color: #FFFFFF;
}

.btn-accent {
  background: #F5A623;
  color: #2D2D2D;
}

.btn-danger {
  background: #C62828;
  color: #FFFFFF;
}

.btn-ghost {
  background: #FFFFFF;
  border: 3rpx solid #2C5F8A;
  color: #2C5F8A;
}

.btn[disabled] {
  opacity: 0.55;
}

.btn-sm {
  min-height: 92rpx;
  border-radius: 46rpx;
  padding: 0 30rpx;
  font-size: 38rpx;
}

/* 表单行 */
.field {
  margin-bottom: 28rpx;
}

.field-label {
  font-size: 40rpx;
  font-weight: bold;
  color: #2D2D2D;
  margin-bottom: 14rpx;
}

.field-label .req {
  color: #C62828;
  margin-right: 4rpx;
}

.input-box {
  display: flex;
  align-items: center;
  background: #FBF5EB;
  border: 3rpx solid #EADFCB;
  border-radius: 20rpx;
  min-height: 116rpx;
  padding: 0 26rpx;
}

.input-box input {
  flex: 1;
  height: 100%;
  font-size: 44rpx;
  color: #2D2D2D;
}

.input-unit {
  font-size: 36rpx;
  color: #7A6B58;
  margin-left: 16rpx;
  white-space: nowrap;
}

.textarea-box {
  background: #FBF5EB;
  border: 3rpx solid #EADFCB;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.textarea-box textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 40rpx;
  color: #2D2D2D;
}

.placeholder-style {
  color: #A89B88;
}

/* 状态文字（均配合图标使用，避免只靠红绿区分） */
.state-taken {
  color: #2E7D32;
}

.state-missed {
  color: #C62828;
}

.state-pending {
  color: #8A6D1D;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 20rpx;
  color: #7A6B58;
  text-align: center;
}

.empty-icon {
  font-size: 90rpx;
  margin-bottom: 20rpx;
}

.empty-title {
  font-size: 42rpx;
  font-weight: bold;
  color: #2D2D2D;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 36rpx;
  line-height: 1.7;
}

/* 首页 2x2 功能宫格通用间距 */
.tile-gap {
  gap: 24rpx;
}
