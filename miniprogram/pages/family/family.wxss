.family-icon {
  text-align: center;
  font-size: 100rpx;
  line-height: 1.4;
}

.bind-tip {
  font-size: 38rpx;
  color: #5F5344;
  line-height: 1.8;
  margin-bottom: 28rpx;
}

.code-input input {
  text-align: center;
  font-size: 60rpx;
  letter-spacing: 20rpx;
  font-weight: bold;
  color: #2C5F8A;
}

.bind-err {
  background: #FBEAE7;
  color: #C62828;
  border-radius: 18rpx;
  padding: 20rpx;
  font-size: 34rpx;
  margin-bottom: 22rpx;
}

.privacy-note {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #A89B88;
  line-height: 1.7;
}

.parent-card {
  background-color: #2C5F8A;
  background-image: linear-gradient(135deg, #2C5F8A 0%, #3E78A5 100%);
  color: #FFFFFF;
}

.parent-name {
  font-size: 52rpx;
  font-weight: bold;
  color: #FFFFFF;
}

.parent-meta {
  margin-top: 10rpx;
  font-size: 36rpx;
  color: #DCE9F4;
}

.parent-desc,
.history-note {
  margin-top: 12rpx;
  font-size: 34rpx;
  color: #DCE9F4;
  line-height: 1.7;
}

.med-line {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  border-bottom: 2rpx solid #F2E9DA;
  padding: 16rpx 0;
}

.med-line:last-child {
  border-bottom: none;
}

.med-line-main {
  flex: 1;
}

.med-line-name {
  font-size: 44rpx;
  font-weight: bold;
}

.med-line-time {
  font-size: 34rpx;
  color: #7A6B58;
}

.med-line-sub {
  margin-top: 6rpx;
  font-size: 34rpx;
  color: #7A6B58;
}

.med-line-status {
  font-size: 38rpx;
  font-weight: bold;
}

.st-taken {
  color: #2E7D32;
}

.st-pending {
  color: #B9770A;
}

.st-missed {
  color: #C62828;
}

.mini-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 90rpx;
  font-size: 36rpx;
  color: #5F5344;
  border-bottom: 2rpx solid #F7F0E4;
}

.mini-line:last-child {
  border-bottom: none;
}

.mini-value {
  font-size: 42rpx;
  font-weight: bold;
  color: #2C5F8A;
}

.small-empty {
  color: #A89B88;
  font-size: 34rpx;
  padding: 20rpx 0;
}

.meal-line {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  border-bottom: 2rpx solid #F7F0E4;
  padding: 14rpx 0;
}

.meal-line:last-child {
  border-bottom: none;
}

.meal-thumb {
  width: 130rpx;
  height: 130rpx;
  border-radius: 18rpx;
  margin-right: 22rpx;
  background: #F5EEDF;
}

.meal-text {
  flex: 1;
}

.meal-title {
  font-size: 38rpx;
  font-weight: bold;
}

.meal-note {
  margin-top: 6rpx;
  font-size: 32rpx;
  color: #7A6B58;
}

.visit-line {
  display: flex;
  padding: 20rpx 0;
}

.visit-dot {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #F5A623;
  margin: 12rpx 20rpx 0 0;
  flex-shrink: 0;
}

.visit-body {
  flex: 1;
}

.visit-title {
  font-size: 38rpx;
  font-weight: bold;
}

.visit-desc {
  margin-top: 8rpx;
  font-size: 34rpx;
  color: #7A6B58;
  line-height: 1.7;
}

.readonly-tip {
  text-align: center;
  color: #A89B88;
  font-size: 30rpx;
  padding: 18rpx 0;
}
